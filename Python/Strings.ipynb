      "H_ll_ th_s _s T_j_sw_n_..!\n",
      "_BCD_FGH_JKLMN_PQRST_VWXYZ\n"
     ]
    }
   ],
   "source": [
    "import re\n",
    "\n",
    "def replaceVowels(str):\n",
    "        return re.sub(r'[aeiouAEIOU]','_',str)\n",
    "\n",
    "\n",
    "str=\"Hello this is Tejaswini..!\"\n",
    "\n",
    "print(replaceVowels(str))\n",
    "\n",
    "str1=\"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\n",
    "print(replaceVowels(str1))"
   ]
  }
